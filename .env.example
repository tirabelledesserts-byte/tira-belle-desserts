# TIRA Belle Backend Environment Configuration
HOST=0.0.0.0
PORT=8001

# Database Configuration (SQLite local or Supabase PostgreSQL)
DATABASE_URL=sqlite:///./data/tirabelle.db
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Storage Integration (for persistent cloud uploads)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]
# SUPABASE_BUCKET=tiramisu-uploads

# Administrative Security Secrets (CRITICAL: Replace with secure random strings)
SECRET_KEY=replace_with_a_secure_random_64_char_key_in_production
CREDENTIAL_SALT=replace_with_a_unique_random_salt_in_production

# Initial Admin Credentials (rotate immediately after first login)
INITIAL_ADMIN_USERNAME=admin@tirabelle.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_password
